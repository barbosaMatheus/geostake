# Display name of the application, shown in the page header.
# Falls back to "GeoStake" when unset.
VITE_APP_NAME=GeoStake

# Vite `base` path (asset/route prefix) for the production build.
# Leave at "/" for the local preview server and Docker/nginx hosting.
# Set to "/geostake/" when building for a GitHub Pages project site.
VITE_BASE_PATH=/
